# Copy this file to .env and fill in your credential.
PORT=1463
HOST=127.0.0.1

# Require your own Bearer key on /v1/*. Keep false while testing on localhost.
REQUIRE_API_KEY=false
ROUTER_API_KEY=

# CodeBuddy CN credential. Either name works; the value is sent as
# "Authorization: Bearer <value>" to copilot.tencent.com.
CODEBUDDY_CN_TOKEN=
CODEBUDDY_CN_API_KEY=

ENABLE_REQUEST_LOGS=true
UPSTREAM_TIMEOUT_MS=300000

# Only for testing against a local stub. Leave empty in normal use.
CODEBUDDY_CN_BASE_URL=
