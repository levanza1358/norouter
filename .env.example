# Copy this file to .env. It contains proxy configuration only.
PORT=5555
HOST=127.0.0.1

# Protect only /v1 and /v1/* with Authorization: Bearer <ROUTER_API_KEY>.
# Dashboard, /api, /health, and assets remain outside this gate.
REQUIRE_API_KEY=false
ROUTER_API_KEY=

# Local SQLite path. Default: data/norouter.db
NOROUTER_DB=

ENABLE_REQUEST_LOGS=true
UPSTREAM_TIMEOUT_MS=300000

# Optional local budget shown in the dashboard. This is not upstream quota.
CODEBUDDY_CN_TOKEN_BUDGET=

# Test-only endpoint overrides. Leave empty in normal/production use.
# They redirect credential-bearing requests to a local stub or controlled test endpoint.
CODEBUDDY_CN_BASE_URL=
CODEBUDDY_CN_REFRESH_URL=
CODEBUDDY_CN_QUOTA_URL=
