# NoRouter configuration. `norouter install` copies this file to .env (mode 0600).
# Values already present in the process environment always win over this file.

# Listener. Default binds every interface so other machines can reach the proxy.
HOST=0.0.0.0
PORT=5555

# Gate /v1 with a bearer key. Managed keys from the API Keys page also work.
# Keep false only when the port is reachable by you alone.
REQUIRE_API_KEY=false
ROUTER_API_KEY=

# Logging and upstream timeout.
ENABLE_REQUEST_LOGS=true
UPSTREAM_TIMEOUT_MS=300000

# Optional SQLite path override (default: data/norouter.db).
# NOROUTER_DB=

# Test/stub overrides. Never point these at fixtures in production.
# CODEBUDDY_CN_BASE_URL=
# CODEBUDDY_CN_REFRESH_URL=
# CODEBUDDY_CN_QUOTA_URL=
# CODEBUDDY_CN_CHECKIN_URL=

# Antigravity OAuth client. No client id/secret is built in: browser login stays
# disabled until both values come from your own Antigravity IDE install.
# ANTIGRAVITY_CLIENT_ID=
# ANTIGRAVITY_CLIENT_SECRET=
# Override the Cloud Code gateway base URL (tests use this; leave unset normally).
# ANTIGRAVITY_BASE_URL=
